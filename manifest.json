{
    "manifest_version": 3,
    "name": "Lens AI",
    "version": "1.0",
    "permissions": [
        "contextMenus",
        "notifications",
        "offscreen"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
}